# 系統服務設定
HOST=0.0.0.0
PORT=8000
API_KEY=your_secret_api_key_here
# 資料庫路徑（預設使用 data/radar.db 以對齊 GitHub Actions 自動化回寫；本機相容亦可指定 data/tracker.db）
DATABASE_PATH=data/radar.db

# 推播通知 Webhook 設定（支援 Discord 與 Telegram，依環境變數自動啟用）
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM 供應商設定 (gemini 或 ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# 爬蟲與增量解析限制
MAX_NEW_DETAILS_PER_RUN=15
CRAWLER_HEADLESS=true
CRAWLER_JITTER_MIN=2.0
CRAWLER_JITTER_MAX=4.5

# 告警預設門檻 (亦可於 config/family_profile.yaml 設定)
ALERT_PRICE_DROP_ADULT=1500
ALERT_PRICE_DROP_FAMILY=10000
